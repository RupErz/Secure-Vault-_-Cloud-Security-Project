# Copy to .env (or run ./scripts/gen_secrets.sh which does it with random values).
# NEVER commit the real .env. The AES master key is NOT in here: it is a Docker
# secret (secrets/master_key.txt), deliberately kept out of env vars and images.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.64.2
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,https://192.168.64.2

# --- Upload policy ---
MAX_UPLOAD_BYTES=1073741824

# --- Login rate limiting (Django layer; nginx has its own on top) ---
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# --- PostgreSQL ---
POSTGRES_DB=securevault
POSTGRES_USER=securevault
POSTGRES_PASSWORD=change-me
